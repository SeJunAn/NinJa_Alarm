<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sumi"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/stats_title"
        app:titleTextColor="@color/washi" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <!-- 성공률 강조 카드 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Ninja.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_xl">

                    <TextView
                        style="@style/TextAppearance.Ninja.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_success_rate" />

                    <TextView
                        android:id="@+id/successRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/seikou"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        tools:text="79%" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/successBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        app:indicatorColor="@color/seikou"
                        app:trackColor="@color/kuro_elevated"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp"
                        tools:progress="79" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 요약 행들 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Ninja.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <include
                        android:id="@+id/rowTotal"
                        layout="@layout/item_stat_row" />

                    <include
                        android:id="@+id/rowAvg"
                        layout="@layout/item_stat_row" />

                    <include
                        android:id="@+id/rowFail"
                        layout="@layout/item_stat_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/statsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/stats_empty"
                android:textColor="@color/kasumi"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
