<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Ninja.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_lg"
    android:layout_marginVertical="@dimen/space_sm"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/seqName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                tools:text="분신술" />

            <TextView
                android:id="@+id/seqCustomBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:text="@string/sequence_custom_badge"
                android:textColor="@color/kasumi"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/seqDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingLeft="@dimen/space_sm"
                android:paddingRight="@dimen/space_sm"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_xs"
                android:textColor="@color/sumi"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="하급" />
        </LinearLayout>

        <TextView
            android:id="@+id/seqNameEn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/kasumi"
            android:textSize="13sp"
            tools:text="Clone Jutsu" />

        <TextView
            android:id="@+id/seqSeals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.Ninja.Kanji"
            android:textColor="@color/washi"
            tools:text="未  巳  寅" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
